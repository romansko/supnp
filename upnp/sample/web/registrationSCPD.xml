<?xml version="1.0"?>
<scpd xmlns="urn:schemas-upnp-org:service-1-0">

  <specVersion>
    <major>1</major>
    <minor>0</minor>
  </specVersion>


  <actionList>

    <action>
      <name>Register</name>
      <argumentList>
         <argument>
           <name>SpecificationDocument</name>
           <relatedStateVariable>DontCare</relatedStateVariable>
           <direction>in</direction>
          </argument>
        <argument>
          <name>CertificateDevice</name>
          <relatedStateVariable>DontCare</relatedStateVariable>
          <direction>in</direction>
        </argument>
        <argument>
          <name>CertificateUCA</name>
          <relatedStateVariable>DontCare</relatedStateVariable>
          <direction>in</direction>
        </argument>
        <argument>
          <name>DescriptionDocumentLocation</name>
          <relatedStateVariable>DontCare</relatedStateVariable>
          <direction>in</direction>
        </argument>
        <argument>
          <name>CapTokenLocation</name>
          <relatedStateVariable>DontCare</relatedStateVariable>
          <direction>in</direction>
        </argument>

      </argumentList>
    </action>

    <action>
      <name>Challenge</name>
      <argumentList>
        <argument>
          <name>ChallengeResponse</name>
          <relatedStateVariable>DontCare</relatedStateVariable>
          <direction>in</direction>
        </argument>
        <argument>
          <name>PublicKey</name>
          <relatedStateVariable>DontCare</relatedStateVariable>
          <direction>in</direction>
        </argument>
      </argumentList>
    </action>

  </actionList>

  <serviceStateTable>
    <stateVariable sendEvents="no">
      <name>DontCare</name>
      <dataType>string</dataType>
    </stateVariable>
  </serviceStateTable>

</scpd>
















